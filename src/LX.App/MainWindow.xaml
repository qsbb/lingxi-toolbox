<ui:FluentWindow x:Class="LingXi.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="凌溪工具箱" Width="1100" Height="720" MinWidth="920" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource LxPageBgBrush}"
                 WindowBackdropType="None"
                 FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 侧栏底部固定"设置"导航钮（外观对齐 LxNavList 行项：圆角行 + 悬停玻璃 + 选中 NavActive） -->
        <Style x:Key="LxSettingsNavButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource LxTextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="10" Padding="12,9" Margin="8,2" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource LxGlassFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource LxNavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="凌溪工具箱" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- L1 玻璃侧栏（控制层） -->
            <Border Grid.Column="0" Margin="10,0,0,10" CornerRadius="16"
                    Background="{DynamicResource LxGlassFillBrush}"
                    BorderBrush="{DynamicResource LxGlassBorderBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="切换主题"
                            Style="{StaticResource LxPillButton}"
                            Margin="12,8" Click="ThemeToggle_Click" />
                    <!-- 固定"设置"导航项：壳内置页，不依赖模块注册（Dock 顺序在主题按钮之上） -->
                    <ToggleButton DockPanel.Dock="Bottom" x:Name="SettingsNavButton"
                                  Style="{StaticResource LxSettingsNavButton}"
                                  Click="SettingsNav_Click"
                                  ToolTip="设置">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="18" />
                            </Border>
                            <TextBlock Text="设置" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ListBox x:Name="NavList"
                             Style="{StaticResource LxNavList}"
                             SelectionChanged="NavList_SelectionChanged" />
                </DockPanel>
            </Border>

            <!-- 模块自管滚动：各视图有自己的 MainScroll。外层再套 ScrollViewer 会形成
                 双层滚动冲突（滚轮被内层吞但内层高度计算失效 → 整页滚不动） -->
            <ContentControl x:Name="ModuleHost" Grid.Column="1" Margin="14,0,10,10" />
        </Grid>
    </Grid>
</ui:FluentWindow>
