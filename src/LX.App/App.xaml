<Application x:Class="LingXi.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI 4.x 官方必需的两个库字典（放前面，后面 LX 令牌可覆盖同名键）：
                     ControlsDictionary 提供 FluentWindow/TitleBar 等全部控件模板 -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- 自有设计令牌 -->
                <ResourceDictionary Source="pack://application:,,,/LX.Ui;component/Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LX.Ui;component/Themes/Glass.xaml" />
                <!-- 壳内 iOS 风格拨动开关（设置页用；模块内资源，不动 LX.Ui 公共样式） -->
                <ResourceDictionary Source="pack://application:,,,/LX.App;component/Themes/ToggleSwitch.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
