<UserControl x:Class="LingXi.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!-- 壳级设置页：通用 / 模块 / 监控 三组（侧栏底部固定"设置"导航项直达，不依赖模块注册） -->

    <StackPanel>
        <!-- 头部（与监控/音频页同基准） -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14"
                    Background="{DynamicResource LxGlassFillBrush}"
                    BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                <TextBlock Text="⚙" FontSize="22"
                           Foreground="{DynamicResource LxTintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="设置" Style="{StaticResource LxTitle}" />
                <TextBlock Text="壳与模块偏好 · 改动即时保存" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- 通用组 -->
        <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="通用" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="0,0,0,6" />

                <!-- 主题（浅色/深色）：切换委托回壳 App.ToggleTheme -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="主题" FontSize="13" Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="浅色 / 深色外观，切换即时生效（等同侧栏「切换主题」按钮）"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Center"
                              Style="{StaticResource LxToggleSwitch}"
                              IsChecked="{Binding IsDark}"
                              ToolTip="深色主题开 / 关" />
                </Grid>

                <!-- 开机自启：复用 LX.Core AutoStartService（HKCU Run 键） -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开机自启" FontSize="13" Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="登录 Windows 后自动启动凌溪工具箱（写入当前用户 Run 键，无需管理员）"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Center"
                              Style="{StaticResource LxToggleSwitch}"
                              IsChecked="{Binding AutoStart}"
                              ToolTip="开机自启开 / 关" />
                </Grid>

                <!-- 关窗驻留托盘 -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="关闭窗口时驻留托盘" FontSize="13" Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="点 ✕ 仅隐藏窗口到托盘；关闭后从托盘图标右键菜单退出"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Center"
                              Style="{StaticResource LxToggleSwitch}"
                              IsChecked="{Binding CloseToTray}"
                              ToolTip="关窗驻留托盘开 / 关" />
                </Grid>
            </StackPanel>
        </controls:LxGlassCard>

        <!-- 模块组 -->
        <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="模块" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="停用的模块在下次启动时不再加载（托盘/热键等资源随模块一并省去）"
                           Style="{StaticResource LxCaption}" Margin="0,0,0,6" />

                <ItemsControl ItemsSource="{Binding ModuleRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox VerticalAlignment="Center"
                                          Style="{StaticResource LxToggleSwitch}"
                                          IsChecked="{Binding Enabled}"
                                          ToolTip="启用 / 停用该模块（重启后生效）" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="开关改动即时落盘；重启工具箱后生效（运行中的模块不做热卸载）。"
                           Style="{StaticResource LxCaption}" Margin="0,8,0,0" />
            </StackPanel>
        </controls:LxGlassCard>

        <!-- 监控组 -->
        <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="监控" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="凌溪·监控 Hub 收数端"
                           Style="{StaticResource LxCaption}" Margin="0,0,0,6" />

                <!-- Hub 绑定全网卡（lx.monitor.BindLan，重启生效） -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hub 绑定全网卡" FontSize="13" Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="开启后局域网内 agent 可直连本机 Hub 上报；关闭则仅本机（127.0.0.1）可连"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Center"
                              Style="{StaticResource LxToggleSwitch}"
                              IsChecked="{Binding BindLan}"
                              ToolTip="绑定全网卡开 / 关（重启后生效）" />
                </Grid>

                <TextBlock Text="重启工具箱后生效；上报目标（双向监控）等其余监控设置在「凌溪·监控」页管理。"
                           Style="{StaticResource LxCaption}" Margin="0,8,0,0" />
            </StackPanel>
        </controls:LxGlassCard>
    </StackPanel>
</UserControl>
