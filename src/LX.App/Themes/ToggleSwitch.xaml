<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Apple 设置（iOS UISwitch）同款拨动开关：
      44×26 胶囊轨道——关 = 浅灰（LxSwitchOffBrush），开 = iOS 绿（LxSwitchOnBrush）；
      22×22 白色圆滑块带微阴影，左右贴边滑动。
      令牌 LxSwitchThumbBrush 此前漏定义导致滑块透明（"开关不显眼"根因），已补三色令牌。
      铁律：Setter 直切状态（无 Storyboard/EnterActions）；Effect 内联在元素上。
    -->
    <Style x:Key="LxToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="26">
                        <Border x:Name="Track"
                                CornerRadius="13"
                                Background="{DynamicResource LxSwitchOffBrush}" />
                        <Ellipse x:Name="Thumb"
                                 Width="22" Height="22"
                                 Fill="{DynamicResource LxSwitchThumbBrush}"
                                 HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                  Opacity="0.3" Color="#FF000000" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource LxSwitchOnBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
