<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LingXi.App</RootNamespace>
    <!-- 多尺寸 BMP 帧 ICO（16/32/48/256，帧表已修复）——资源管理器/任务栏/托盘统一 logo -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 单文件发布：依赖打进 exe，安装目录只有一个文件（.NET 8 框架由系统共享） -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LX.Module.Sdk\LX.Module.Sdk.csproj" />
    <ProjectReference Include="..\LX.Core\LX.Core.csproj" />
    <ProjectReference Include="..\LX.Ui\LX.Ui.csproj" />
    <ProjectReference Include="..\LX.AudioSwitch\LX.AudioSwitch.csproj" />
    <ProjectReference Include="..\LX.Monitor\LX.Monitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.png" />
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

</Project>
