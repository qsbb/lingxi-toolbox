<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!--
      凌溪·音频 模块私有样式（只由 AudioView.xaml 合并，不进入 LX.Ui 公共令牌库）。
      铁律：
      - 颜色/圆角一律 DynamicResource 引 Tokens.*.xaml 令牌，禁止硬编码色值
        （Effect/动画等 Freezable 例外：见下）；
      - 设备卡样式不 BasedOn 也不自带模板，未设置的属性回落到 LX.Ui Generic.xaml 的
        默认玻璃卡样式（Background/描边/CornerRadius/阴影），只按需覆盖；
      - 玻璃只属于控制层（卡片/键帽/HUD 浮层），内容层保持实色。
      冻结陷阱（实机踩坑记录，勿回退）：
      - 资源字典级共享 Freezable（DropShadowEffect 资源项）被 Style.Triggers 引用
        会在 Seal 时触发"已冻结对象修改"异常 → Effect 一律内联在 Setter.Value；
      - Style.Triggers 的 EnterActions/ExitActions Storyboard 在本环境同样触发
        TriggerActionCollection 冻结异常 → 状态切换用 Setter 直切，
        过渡动画由 VM 层 DispatcherTimer + Opacity 属性驱动。
    -->

    <!-- ============ 设备卡：当前设备 tint 描边 + tint 玻璃填充 + 光晕 ============ -->
    <Style x:Key="LxDeviceCard" TargetType="controls:LxGlassCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <!-- 缺陷 2：设备卡本体圆角显式走 LxRadiusSheet(=20)（大面卡片=圆角矩形），
             覆盖 LX.Ui Generic.xaml 默认的 LxRadiusCard(=16)，令牌依赖显式化；胶囊仅保留给文字 pill/HUD -->
        <Setter Property="CornerRadius" Value="{DynamicResource LxRadiusSheet}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LxTintBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Background" Value="{DynamicResource LxNavActiveBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <!-- 内联 Effect（Freezable 不共享、不进资源字典，规避冻结冲突）；
                             ShadowDepth=0 tint 光晕模拟 iOS 聚焦环 -->
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45"
                                          Color="{StaticResource LxTintBlueColor}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 切换成功瞬时高亮层：VM 驱动 Opacity（0.35 → 0），样式只负责静态属性 -->
    <Style x:Key="LxCardFlashLayer" TargetType="Border">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource LxTintBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource LxRadiusControl}" />
    </Style>

    <!-- 当前设备对勾徽章（仅 IsCurrent=True 显示） -->
    <Style x:Key="LxCurrentBadge" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <!-- 缺陷 2：26×26 对勾徽章从胶囊（999 → 全圆/椭圆感）改为圆角矩形，取 LxRadiusControl(=10，
             落在要求的 8~10 区间且保持令牌引用、不硬编码）；对勾内容由 AudioView 的自绘 Path 承载 -->
        <Setter Property="CornerRadius" Value="{DynamicResource LxRadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource LxNavActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LxTintBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="ToolTip" Value="当前默认设备" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 切换按钮：基于公共主胶囊按钮，当前设备整只隐藏（徽章接管右侧） -->
    <Style x:Key="LxDeviceSwitchButton" TargetType="Button" BasedOn="{StaticResource LxAccentPillButton}">
        <Setter Property="Padding" Value="16,7" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 分组小标题（LxCaption 风格）与数量徽章 ============ -->
    <Style x:Key="LxGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LxCountBadge" TargetType="Border">
        <!-- 数量徽章语义=文字 pill，按缺陷 2 原则保留胶囊 -->
        <Setter Property="CornerRadius" Value="{DynamicResource LxRadiusCapsule}" />
        <Setter Property="Background" Value="{DynamicResource LxNavActiveBrush}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LxCountBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource LxTintBrush}" />
    </Style>

    <!-- ============ 键帽（kbd 风格小圆角玻璃块） ============ -->
    <Style x:Key="LxKeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LxGlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LxGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ HUD 浮层：切换成功提示（ShowSwitchHud 开关在 VM 内复用） ============ -->
    <Style x:Key="LxSwitchHud" TargetType="Border">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <!-- HUD 浮层语义=浮层提示，按缺陷 2 原则保留胶囊 -->
        <Setter Property="CornerRadius" Value="{DynamicResource LxRadiusCapsule}" />
        <Setter Property="Background" Value="{DynamicResource LxPillInfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LxGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Effect">
            <Setter.Value>
                <!-- 内联阴影（参数同 LX.Ui 的 LxCardShadow；阴影色为中性色不随主题） -->
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.12" Color="#53637D" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <!-- 显隐由 VM 属性直切（过渡动画由 VM 的 DispatcherTimer 驱动 Opacity） -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSwitchHudOpen}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="0" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
