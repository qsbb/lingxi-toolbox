<Window x:Class="LingXi.AudioSwitch.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加音频设备" Width="480" Height="560" MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LxPageBgBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="选择要保存的设备" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource LxTextPrimaryBrush}" />
            <TextBlock Text="仅显示当前可用的播放设备" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource LxTextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="14"
                Background="{DynamicResource LxGlassFillBrush}"
                BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
            <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent" Padding="8"
                     SelectionChanged="DeviceList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Border Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource LxGlassFillBrush}">
                                <TextBlock Text="♫" FontSize="14"
                                           Foreground="{DynamicResource LxTintBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource LxPillButton}" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="AddButton" Content="添加" Style="{StaticResource LxAccentPillButton}"
                    Click="Add_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
