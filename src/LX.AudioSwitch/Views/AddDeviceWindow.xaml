<Window x:Class="LingXi.AudioSwitch.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加音频设备" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <!--
      添加音频设备悬浮窗（页头 "＋ 添加设备"）：监控 AddMachineWindow 同款自绘玻璃 Sheet。
      设备列表选择 → 确认添加；Esc/关闭钮/点窗外空白均可关闭。
      嵌套滚动铁律：全窗仅这一个 ScrollViewer。
    -->

    <Border x:Name="Sheet" Margin="18"
            CornerRadius="{DynamicResource LxRadiusSheet}"
            Background="{DynamicResource LxPageBgBrush}"
            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#53637D" />
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>

        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16">

                <!-- 标题行 + 关闭（Path 自绘） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="添加音频设备" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="仅显示当前可用的播放设备，选中后确认添加"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="Close_Click" ToolTip="关闭"
                            VerticalAlignment="Center" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Width="28" Height="28" CornerRadius="14"
                                        Background="Transparent">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="None"
                                          Stroke="{DynamicResource LxTextSecondaryBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource LxGlassFillBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 设备列表 -->
                <Border CornerRadius="{DynamicResource LxRadiusCard}"
                        Background="{DynamicResource LxGlassFillBrush}"
                        BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1"
                        Margin="0,14,0,0" Padding="8">
                    <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent"
                             MaxHeight="360" SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{DynamicResource LxGlassFillBrush}"
                                            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="&#xE767;" FontSize="13"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                   Foreground="{DynamicResource LxTintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 空态 -->
                <TextBlock x:Name="EmptyText" Text="没有可添加的设备（当前播放设备均已保存）"
                           Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Style="{StaticResource LxCaption}" />

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Style="{StaticResource LxPillButton}" Click="Cancel_Click" Margin="0,0,10,0" />
                    <Button x:Name="AddButton" Content="添加" Style="{StaticResource LxAccentPillButton}"
                            Click="Add_Click" IsEnabled="False" MinWidth="96" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
