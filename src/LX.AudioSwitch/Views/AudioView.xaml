<UserControl x:Class="LingXi.AudioSwitch.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!-- 音频快切主视图（开发文档 8.6） -->

    <Grid>
        <TextBlock x:Name="FallbackText"
                   Text="音频服务不可用：请确认系统音频服务正在运行后重启凌溪工具箱。"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Visibility="Collapsed"
                   Foreground="{DynamicResource LxTextSecondaryBrush}" />

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <Grid Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource LxGlassFillBrush}"
                            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                        <TextBlock Text="♫" FontSize="22"
                                   Foreground="{DynamicResource LxTintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="凌溪·音频" Style="{StaticResource LxTitle}" />
                        <TextBlock Text="快速切换音频输出设备" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource LxAccentPillButton}"
                            Content="＋ 添加设备" Command="{Binding AddCommand}"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- 当前默认设备卡 -->
                <controls:LxGlassCard Grid.Row="1" CornerRadius="{DynamicResource LxRadiusSheet}"
                                      Padding="18,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource LxStatusOkFgBrush}" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="当前默认设备" Style="{StaticResource LxCaption}" />
                                <TextBlock Text="{Binding CurrentDeviceName}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource LxGlassFillBrush}"
                                CornerRadius="{DynamicResource LxRadiusCapsule}" Padding="11,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceCountText}" FontSize="12"
                                       Foreground="{DynamicResource LxTextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </controls:LxGlassCard>

                <TextBlock Grid.Row="2" Text="已保存设备" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="2,0,0,12" />

                <!-- 设备列表 -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LxGlassCard Margin="0,0,0,10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource LxGlassFillBrush}">
                                        <TextBlock Text="♫" FontSize="18"
                                                   Foreground="{DynamicResource LxTintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}"
                                                               Margin="0,6,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource LxAccentPillButton}"
                                            Content="切换" Padding="16,7" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsAvailable}"
                                            Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Style="{StaticResource LxIconGhostButton}"
                                            Content="×" Margin="10,0,0,0" VerticalAlignment="Center"
                                            ToolTip="移除已保存设备"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </controls:LxGlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="4" Margin="2,8,0,0"
                           Text="已拔出的设备会保留在列表中 · 点击 × 可删除保存记录 · Ctrl+Alt+A 循环切换"
                           Style="{StaticResource LxCaption}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
