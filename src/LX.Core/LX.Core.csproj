<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LingXi.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- H.GeneratedIcons 2.4.1 声明依赖 System.Drawing.Common>=10.0.0（跨大版本），
         强制压回 8.0.x 与运行时对齐；库仅用基础绘图 API，允许 NU1605 降级警告 -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LX.Module.Sdk\LX.Module.Sdk.csproj" />
  </ItemGroup>

</Project>
