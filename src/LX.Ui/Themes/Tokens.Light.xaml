<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      凌溪设计令牌 · Light
      与《iOS26-LiquidGlass-Unity-USS-设计规范.md》同源：同一套圆角阶梯 / 语义色 / 玻璃透明度带。
    -->

    <!-- 语义色 -->
    <Color x:Key="LxTintBlueColor">#007AFF</Color>
    <Color x:Key="LxGreenColor">#34C759</Color>
    <Color x:Key="LxOrangeColor">#FF9F0A</Color>
    <Color x:Key="LxRedColor">#FF3B30</Color>

    <!-- 文本 -->
    <SolidColorBrush x:Key="LxTextPrimaryBrush" Color="#F01C1C1E" />
    <SolidColorBrush x:Key="LxTextSecondaryBrush" Color="#FF8A8A8E" />

    <!-- 主题 -->
    <SolidColorBrush x:Key="LxTintBrush" Color="#FF007AFF" />
    <SolidColorBrush x:Key="LxSwitchOnBrush" Color="#FF34C759" />
    <SolidColorBrush x:Key="LxSwitchOffBrush" Color="#FFE9E9EA" />
    <SolidColorBrush x:Key="LxSwitchThumbBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LxPageBgBrush" Color="#FFF2F2F7" />

    <!-- 玻璃材质（浅色背景：白 10%~25% 带） -->
    <SolidColorBrush x:Key="LxGlassFillBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="LxGlassFillHoverBrush" Color="#40FFFFFF" />
    <LinearGradientBrush x:Key="LxGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxNavActiveBrush" Color="#1A007AFF" />

    <!-- 状态 pill：Fg=圆点/文字，Bg=胶囊底 -->
    <SolidColorBrush x:Key="LxStatusOkFgBrush" Color="#FF248A3D" />
    <SolidColorBrush x:Key="LxStatusWarnFgBrush" Color="#FFB25000" />
    <SolidColorBrush x:Key="LxStatusBadFgBrush" Color="#FFD70015" />
    <SolidColorBrush x:Key="LxStatusInfoFgBrush" Color="#FF007AFF" />
    <SolidColorBrush x:Key="LxPillOkBgBrush" Color="#FFC9F0D8" />
    <SolidColorBrush x:Key="LxPillWarnBgBrush" Color="#FFFFE3BF" />
    <SolidColorBrush x:Key="LxPillBadBgBrush" Color="#FFFFD2CE" />
    <SolidColorBrush x:Key="LxPillInfoBgBrush" Color="#FFD8E9FF" />

    <!-- 圆角阶梯（iOS 26：fixed 10 / 卡 16 / 浮层 20 / capsule=高÷2） -->
    <CornerRadius x:Key="LxRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="LxRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="LxRadiusSheet">20</CornerRadius>
    <CornerRadius x:Key="LxRadiusCapsule">10</CornerRadius>

</ResourceDictionary>
