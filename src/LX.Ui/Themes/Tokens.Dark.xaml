<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      凌溪设计令牌 · Dark
      深色玻璃：暗填充（近黑但透）+ 保留边缘高光；文字浅色。
    -->

    <!-- 语义色 -->
    <Color x:Key="LxTintBlueColor">#0A84FF</Color>
    <Color x:Key="LxGreenColor">#30D158</Color>
    <Color x:Key="LxOrangeColor">#FF9F0A</Color>
    <Color x:Key="LxRedColor">#FF453A</Color>

    <!-- 文本 -->
    <SolidColorBrush x:Key="LxTextPrimaryBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="LxTextSecondaryBrush" Color="#FF98989D" />

    <!-- 主题 -->
    <SolidColorBrush x:Key="LxTintBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="LxPageBgBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="LxSwitchOnBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="LxSwitchOffBrush" Color="#FF39393D" />
    <SolidColorBrush x:Key="LxSwitchThumbBrush" Color="#FFFFFFFF" />

    <!-- 玻璃材质（深色：rgba(30,30,34,~0.6) + 白 3%~30% 描边） -->
    <SolidColorBrush x:Key="LxGlassFillBrush" Color="#991E1E22" />
    <SolidColorBrush x:Key="LxGlassFillHoverBrush" Color="#B31E1E22" />
    <LinearGradientBrush x:Key="LxGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LxNavActiveBrush" Color="#330A84FF" />

    <!-- 状态 pill：亮语义色 + 半透明胶囊底 -->
    <SolidColorBrush x:Key="LxStatusOkFgBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="LxStatusWarnFgBrush" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="LxStatusBadFgBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="LxStatusInfoFgBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="LxPillOkBgBrush" Color="#3330D158" />
    <SolidColorBrush x:Key="LxPillWarnBgBrush" Color="#33FF9F0A" />
    <SolidColorBrush x:Key="LxPillBadBgBrush" Color="#33FF453A" />
    <SolidColorBrush x:Key="LxPillInfoBgBrush" Color="#330A84FF" />

    <!-- 圆角阶梯 -->
    <CornerRadius x:Key="LxRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="LxRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="LxRadiusSheet">20</CornerRadius>
    <CornerRadius x:Key="LxRadiusCapsule">10</CornerRadius>

</ResourceDictionary>
