<UserControl x:Class="LingXi.Monitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!--
      监控仪表盘（开发文档 9.5）· 信息架构改版：
      页面只保留机器状态列表（+ 已隐藏机器折叠区）；
      添加机器引导 / 上报目标管理 / 机器详情收进悬浮窗
      （AddMachineWindow / ReporterManagerWindow / MachineDetailWindow）。
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="FallbackText"
                   Text="监控未就绪：LX Hub 启动失败，请查看 %LocalAppData%\LingXi\logs 日志。"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Visibility="Collapsed"
                   Foreground="{DynamicResource LxTextSecondaryBrush}" />

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0">

                <!-- 头部 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="{DynamicResource LxGlassFillBrush}"
                            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                        <TextBlock Text="▦" FontSize="22"
                                   Foreground="{DynamicResource LxTintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="机器状态监控" Style="{StaticResource LxTitle}" />
                        <TextBlock Text="本地收数端 · 与 servermonitor 协议同源" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 机器状态标题行：右侧"+ 添加机器"胶囊 → AddMachineWindow 悬浮窗 -->
                <Grid Margin="2,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="机器状态" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="agent 上报后自动出现在这里；点卡片右上角 ⋮ 查看详情"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ 添加机器" Style="{StaticResource LxAccentPillButton}"
                            Command="{Binding OpenAddMachineCommand}" VerticalAlignment="Center"
                            ToolTip="打开添加机器悬浮窗：局域网 agent 接入 + 上报目标管理" />
                </Grid>

                <!-- 空态提示 -->
                <TextBlock Text="暂无机器。点右上角「+ 添加机器」复制部署命令，agent 上报后自动出现在这里。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMachines}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 机器卡片 -->
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LxGlassCard Width="330" Margin="0,0,12,12" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LxCaption}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LxStatusPill Text="置顶" Level="Info" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                            <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}" />
                                            <Button Style="{StaticResource LxIconGhostButton}" Content="⋮" FontSize="14"
                                                    Margin="4,0,0,0" Click="MenuButton_Click" ToolTip="机器操作：详情 / 编辑 / 置顶 / 隐藏">
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                 Background="{DynamicResource LxPageBgBrush}"
                                                                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                                 BorderBrush="{DynamicResource LxGlassBorderBrush}">
                                                        <MenuItem Header="显示详情"
                                                                  Command="{Binding Owner.ShowMachineDetailCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                        <MenuItem Header="编辑…"
                                                                  Command="{Binding Owner.SetAliasCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                        <!-- 删除：仅未上报过的档案机器（上报过的删了会随下一包快照回来，走隐藏） -->
                                                        <MenuItem Header="删除"
                                                                  Command="{Binding Owner.DeleteMachineCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                                  Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                                  ToolTip="从档案移除该机器（仅未上报的档案机器）" />
                                                        <Separator />
                                                        <MenuItem Header="{Binding PinMenuText}"
                                                                  Command="{Binding Owner.TogglePinCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                        <MenuItem Header="隐藏此机器"
                                                                  Command="{Binding Owner.HideMachineCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding CpuUsage}" Margin="0,5,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内存" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding MemUsage}" Margin="0,5,0,0" />

                                    <TextBlock Text="{Binding NetText}" Style="{StaticResource LxCaption}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OsText}" Style="{StaticResource LxCaption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastSeenText}" Style="{StaticResource LxCaption}" />
                                    </Grid>
                                </StackPanel>
                            </controls:LxGlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 已隐藏机器折叠区（可恢复） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,6,0,18">
                    <controls:LxGlassCard.Style>
                        <Style TargetType="controls:LxGlassCard">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHiddenMachines}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:LxGlassCard.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HiddenHeaderText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource LxTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource LxPillButton}"
                                    Command="{Binding ToggleHiddenCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HiddenToggleText}" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HiddenMachines}" Margin="0,10,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HiddenExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LxCaption}" Margin="8,0,0,0"
                                                       Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}" />
                                            <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复显示" Style="{StaticResource LxPillButton}"
                                                Command="{Binding Owner.UnhideMachineCommand}" CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="隐藏只是从仪表盘移除显示，不影响快照收数；恢复后按档案合并规则重新出现。"
                                   Style="{StaticResource LxCaption}" Margin="0,4,0,0" />
                    </StackPanel>
                </controls:LxGlassCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
