<UserControl x:Class="LingXi.Monitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!-- 监控仪表盘（开发文档 9.5）+ 机器列表管理（档案合并/添加引导/编辑） -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="FallbackText"
                   Text="监控未就绪：LX Hub 启动失败，请查看 %LocalAppData%\LingXi\logs 日志。"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Visibility="Collapsed"
                   Foreground="{DynamicResource LxTextSecondaryBrush}" />

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0">

                <!-- 头部 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource LxGlassFillBrush}"
                            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                        <TextBlock Text="▦" FontSize="22"
                                   Foreground="{DynamicResource LxTintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="凌溪·监控" Style="{StaticResource LxTitle}" />
                        <TextBlock Text="本地收数端 · 与 servermonitor 协议同源" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 添加机器引导卡（可折叠；无档案机器时默认展开） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="添加机器" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                <TextBlock Text="把官方 agent 指向本机 Hub，装好后自动出现在列表" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource LxPillButton}"
                                    Command="{Binding ToggleGuideCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GuideToggleText}" />
                            </Button>
                        </Grid>

                        <StackPanel Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GuideExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Report URL（局域网） -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Report URL（局域网，取第一个非回环 IPv4）" Style="{StaticResource LxCaption}" />
                                    <TextBlock Text="{Binding LanReportUrl}" FontSize="13" Margin="0,3,0,0"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                        Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding LanReportUrl}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>

                            <!-- Hub Token -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hub Token" Style="{StaticResource LxCaption}" />
                                    <TextBlock Text="{Binding HubToken}" FontSize="13" Margin="0,3,0,0"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                        Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding HubToken}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>

                            <!-- 官方 agent 一行部署命令（PowerShell） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Agent 部署命令（PowerShell，把 &lt;机器名&gt; 换成目标机器名）" Style="{StaticResource LxCaption}" />
                                    <TextBlock Text="{Binding DeployCommand}" FontSize="12" Margin="0,3,0,0"
                                               FontFamily="Consolas, Courier New"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                        Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding DeployCommand}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>

                            <TextBlock Style="{StaticResource LxCaption}" Margin="0,12,0,0"
                                       Text="官方 agent v0.1.14 从 github.com/qsbb/servermonitor 获取（Node 18+ 或 pkg exe）；装好并开始上报后自动出现在下方列表。" />
                        </StackPanel>
                    </StackPanel>
                </controls:LxGlassCard>

                <!-- LX Hub 信息卡 -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="LX Hub 收数端" Style="{StaticResource LxCaption}" />
                        <TextBlock Text="{Binding HubReportUrl}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="Token" Style="{StaticResource LxCaption}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding HubToken}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource LxCaption}" Margin="0,10,0,0"
                                   Text="上面是本机回环地址；给局域网/远程机器部署 agent 请用顶部「添加机器」引导卡里的地址与命令。" />
                    </StackPanel>
                </controls:LxGlassCard>

                <!-- 上报目标卡（双向监控） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
                    <controls:LxGlassCard.Style>
                        <Style TargetType="controls:LxGlassCard">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReporters}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:LxGlassCard.Style>
                    <StackPanel>
                        <TextBlock Text="上报端（双向监控）" Style="{StaticResource LxCaption}" />
                        <TextBlock Text="本机指标正在按 servermonitor 协议上报给以下服务器" FontSize="12" Margin="0,3,0,8"
                                   Foreground="{DynamicResource LxTextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ReporterStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" FontSize="12"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <controls:LxStatusPill Grid.Column="1" Text="{Binding StatusText}" Level="{Binding Level}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="在 settings.json 的 lx.monitor.reporters 中配置上报目标（url/token/enabled/intervalSec）"
                                   Style="{StaticResource LxCaption}" Margin="0,8,0,0" />
                    </StackPanel>
                </controls:LxGlassCard>

                <TextBlock Text="机器状态" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="2,0,0,12" />

                <!-- 空态提示 -->
                <TextBlock Text="暂无机器。点开顶部「添加机器」复制部署命令，agent 上报后自动出现在这里。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMachines}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 机器卡片 -->
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LxGlassCard Width="330" Margin="0,0,12,12" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LxCaption}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LxStatusPill Text="置顶" Level="Info" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                            <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}" />
                                            <Button Style="{StaticResource LxIconGhostButton}" Content="⋮" FontSize="14"
                                                    Margin="4,0,0,0" Click="MenuButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                 Background="{DynamicResource LxPageBgBrush}"
                                                                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                                 BorderBrush="{DynamicResource LxGlassBorderBrush}">
                                                        <MenuItem Header="设置别名…"
                                                                  Command="{Binding Owner.SetAliasCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                        <MenuItem Header="{Binding PinMenuText}"
                                                                  Command="{Binding Owner.TogglePinCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                        <Separator />
                                                        <MenuItem Header="隐藏此机器"
                                                                  Command="{Binding Owner.HideMachineCommand}" CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding CpuUsage}" Margin="0,5,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内存" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding MemUsage}" Margin="0,5,0,0" />

                                    <TextBlock Text="{Binding NetText}" Style="{StaticResource LxCaption}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OsText}" Style="{StaticResource LxCaption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastSeenText}" Style="{StaticResource LxCaption}" />
                                    </Grid>
                                </StackPanel>
                            </controls:LxGlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 已隐藏机器折叠区（可恢复） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,6,0,18">
                    <controls:LxGlassCard.Style>
                        <Style TargetType="controls:LxGlassCard">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHiddenMachines}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:LxGlassCard.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HiddenHeaderText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource LxTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource LxPillButton}"
                                    Command="{Binding ToggleHiddenCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HiddenToggleText}" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HiddenMachines}" Margin="0,10,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HiddenExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LxCaption}" Margin="8,0,0,0"
                                                       Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}" />
                                            <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复显示" Style="{StaticResource LxPillButton}"
                                                Command="{Binding Owner.UnhideMachineCommand}" CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="隐藏只是从仪表盘移除显示，不影响快照收数；恢复后按档案合并规则重新出现。"
                                   Style="{StaticResource LxCaption}" Margin="0,4,0,0" />
                    </StackPanel>
                </controls:LxGlassCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
