<UserControl x:Class="LingXi.Monitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui">

    <!-- 监控仪表盘（开发文档 9.5） -->

    <Grid>
        <TextBlock x:Name="FallbackText"
                   Text="监控未就绪：LX Hub 启动失败，请查看 %LocalAppData%\LingXi\logs 日志。"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Visibility="Collapsed"
                   Foreground="{DynamicResource LxTextSecondaryBrush}" />

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0">

                <!-- 头部 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource LxGlassFillBrush}"
                            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
                        <TextBlock Text="▦" FontSize="22"
                                   Foreground="{DynamicResource LxTintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="凌溪·监控" Style="{StaticResource LxTitle}" />
                        <TextBlock Text="本地收数端 · 与 servermonitor 协议同源" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- LX Hub 信息卡 -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="LX Hub 收数端" Style="{StaticResource LxCaption}" />
                        <TextBlock Text="{Binding HubReportUrl}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="Token" Style="{StaticResource LxCaption}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding HubToken}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource LxCaption}" Margin="0,10,0,0"
                                   Text="把 agent 的 --report-url 指向上面的地址即可；可在 settings.json 的 lx.monitor 段开启转发到 Yunzai / 托管 agent。" />
                    </StackPanel>
                </controls:LxGlassCard>

                <!-- 上报目标卡（双向监控） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusSheet}" Padding="18,14" Margin="0,0,0,18">
                    <controls:LxGlassCard.Style>
                        <Style TargetType="controls:LxGlassCard">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReporters}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:LxGlassCard.Style>
                    <StackPanel>
                        <TextBlock Text="上报端（双向监控）" Style="{StaticResource LxCaption}" />
                        <TextBlock Text="本机指标正在按 servermonitor 协议上报给以下服务器" FontSize="12" Margin="0,3,0,8"
                                   Foreground="{DynamicResource LxTextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ReporterStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" FontSize="12"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <controls:LxStatusPill Grid.Column="1" Text="{Binding StatusText}" Level="{Binding Level}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="在 settings.json 的 lx.monitor.reporters 中配置上报目标（url/token/enabled/intervalSec）"
                                   Style="{StaticResource LxCaption}" Margin="0,8,0,0" />
                    </StackPanel>
                </controls:LxGlassCard>

                <TextBlock Text="机器状态" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource LxTextPrimaryBrush}" Margin="2,0,0,12" />

                <!-- 空态提示 -->
                <TextBlock Text="暂无机器上报。启动 agent 并把 --report-url 指向上方地址。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMachines}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 机器卡片 -->
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LxGlassCard Width="330" Margin="0,0,12,12" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <controls:LxStatusPill Grid.Column="1" Text="{Binding StatusText}" Level="{Binding Level}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding CpuUsage}" Margin="0,5,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内存" Style="{StaticResource LxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemText}" FontSize="12"
                                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                                 Value="{Binding MemUsage}" Margin="0,5,0,0" />

                                    <TextBlock Text="{Binding NetText}" Style="{StaticResource LxCaption}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource LxCaption}" Margin="0,4,0,0" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OsText}" Style="{StaticResource LxCaption}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastSeenText}" Style="{StaticResource LxCaption}" />
                                    </Grid>
                                </StackPanel>
                            </controls:LxGlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
