<Window x:Class="LingXi.Monitor.Views.MachineDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui"
        Title="机器详情" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <!--
      机器详情悬浮窗（卡片 ⋮ → 显示详情）：自绘玻璃 Sheet（WindowStyle=None + AllowsTransparency）。
      DataContext = MachineCardVm（快照差量更新同一实例 → 窗口内容实时刷新）。
      嵌套滚动铁律：全窗仅这一个 ScrollViewer。
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 玻璃 Sheet：阴影 Effect 按冻结陷阱内联在 Setter.Value，不做共享资源引用 -->
    <Border x:Name="Sheet" Margin="18"
            CornerRadius="{DynamicResource LxRadiusSheet}"
            Background="{DynamicResource LxPageBgBrush}"
            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#53637D" />
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>

        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16">

                <!-- 标题行：名称/别名 + 状态 pill + 关闭（关闭图标 Path 自绘，避开 Segoe 字形豆腐块） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource LxCaption}" Margin="0,2,0,0"
                                   Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LxStatusPill Text="{Binding StatusText}" Level="{Binding Level}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource LxIconGhostButton}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="None"
                                  Stroke="{DynamicResource LxTextSecondaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 概要：平台 / 主机名 / 上线时长 / 最后上报 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="平台" Style="{StaticResource LxCaption}" Margin="0,0,0,5" />
                    <TextBlock Grid.Column="1" Text="{Binding PlatformText}" FontSize="12" Margin="18,0,0,5"
                               Foreground="{DynamicResource LxTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Text="主机名" Style="{StaticResource LxCaption}" Margin="0,0,0,5" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HostText}" FontSize="12" Margin="18,0,0,5"
                               Foreground="{DynamicResource LxTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Text="上线时长" Style="{StaticResource LxCaption}" Margin="0,0,0,5" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UptimeText}" FontSize="12" Margin="18,0,0,5"
                               Foreground="{DynamicResource LxTextPrimaryBrush}" />

                    <TextBlock Grid.Row="3" Text="最后上报" Style="{StaticResource LxCaption}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastSeenText}" FontSize="12" Margin="18,0,0,0"
                               Foreground="{DynamicResource LxTextPrimaryBrush}" />
                </Grid>

                <Border Height="1" Margin="0,14" Background="{DynamicResource LxGlassFillBrush}" />

                <!-- CPU：使用率 + 温度 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Style="{StaticResource LxCaption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding CpuText}" FontSize="12"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="{Binding CpuTempText}" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{DynamicResource LxTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                             Value="{Binding CpuUsage}" Margin="0,5,0,0" />

                <!-- 内存：用量/总量 + 进度条 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="内存" Style="{StaticResource LxCaption}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MemText}" FontSize="12"
                               Foreground="{DynamicResource LxTextPrimaryBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                             Value="{Binding MemUsage}" Margin="0,5,0,0" />

                <!-- 磁盘：每个挂载点一行（挂载点 / 用量/总量 + 进度条） -->
                <TextBlock Text="磁盘" Style="{StaticResource LxCaption}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mount}" FontSize="12"
                                               Foreground="{DynamicResource LxTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource LxTextSecondaryBrush}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource LxMetricBar}" Maximum="100"
                                             Value="{Binding Percent}" Margin="0,5,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无磁盘数据">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Disks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 网络：网卡名 + 上下行速率 -->
                <TextBlock Text="网络" Style="{StaticResource LxCaption}" Margin="0,4,0,6" />
                <ItemsControl ItemsSource="{Binding Nets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Iface}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DownText}" FontSize="12"
                                               Foreground="{DynamicResource LxTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding UpText}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource LxTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无网络数据">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Nets.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 上报设置（仅本机可见：上报目标是全局配置，上报的是本机指标） -->
                <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocal}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Height="1" Margin="0,10" Background="{DynamicResource LxGlassFillBrush}" />
                    <Button Content="上报设置…" Style="{StaticResource LxPillButton}" HorizontalAlignment="Left"
                            Command="{Binding Owner.OpenReporterManagerCommand}"
                            ToolTip="管理本机指标的上报目标（双向监控）" />
                    <TextBlock Text="上报目标为全局配置：把本机指标按 servermonitor 协议上报给其他服务器。"
                               Style="{StaticResource LxCaption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
