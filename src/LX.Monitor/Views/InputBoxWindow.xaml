<Window x:Class="LingXi.Monitor.Views.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource LxPageBgBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <!-- 通用单行输入框（机器别名等）——仅用 LX 令牌，无硬编码颜色 -->

    <StackPanel Margin="22,18">
        <TextBlock x:Name="MessageText" Text="请输入"
                   FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource LxTextPrimaryBrush}" />

        <TextBox x:Name="ValueBox" Margin="0,12,0,0" Padding="10,8" FontSize="14"
                 Background="{DynamicResource LxGlassFillBrush}"
                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                 BorderBrush="{DynamicResource LxGlassBorderBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource LxPillButton}" IsCancel="True" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource LxAccentPillButton}" IsDefault="True"
                    Margin="10,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
