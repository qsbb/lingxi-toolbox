<Window x:Class="LingXi.Monitor.Views.ReporterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上报目标" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource LxPageBgBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <!-- 上报目标编辑对话框（新增/编辑共用；沿用 InputBoxWindow 的玻璃令牌风格） -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LX.Monitor;component/Themes/ToggleSwitch.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="22,18">
        <TextBlock x:Name="HeaderText" Text="添加上报目标" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
        <TextBlock Text="本机指标将按 servermonitor 协议定时 POST 到该地址（X-SM-Token 鉴权）。"
                   Style="{StaticResource LxCaption}" Margin="0,3,0,0" />

        <TextBlock Text="Report URL *" Style="{StaticResource LxCaption}" Margin="0,14,0,0" />
        <TextBox x:Name="UrlBox" Margin="0,5,0,0" Padding="10,8" FontSize="13"
                 Background="{DynamicResource LxGlassFillBrush}"
                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                 BorderBrush="{DynamicResource LxGlassBorderBrush}" />

        <TextBlock Text="Token（目标服务器的 X-SM-Token）" Style="{StaticResource LxCaption}" Margin="0,12,0,0" />
        <TextBox x:Name="TokenBox" Margin="0,5,0,0" Padding="10,8" FontSize="13"
                 Background="{DynamicResource LxGlassFillBrush}"
                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                 BorderBrush="{DynamicResource LxGlassBorderBrush}" />

        <TextBlock Text="名称（可空，留空使用本机机器名）" Style="{StaticResource LxCaption}" Margin="0,12,0,0" />
        <TextBox x:Name="NameBox" Margin="0,5,0,0" Padding="10,8" FontSize="13"
                 Background="{DynamicResource LxGlassFillBrush}"
                 Foreground="{DynamicResource LxTextPrimaryBrush}"
                 BorderBrush="{DynamicResource LxGlassBorderBrush}" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="间隔（秒，≥5）" Style="{StaticResource LxCaption}" />
                <TextBox x:Name="IntervalBox" Width="90" Margin="0,5,0,0" Padding="10,8" FontSize="13"
                         Background="{DynamicResource LxGlassFillBrush}"
                         Foreground="{DynamicResource LxTextPrimaryBrush}"
                         BorderBrush="{DynamicResource LxGlassBorderBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="超时（毫秒，≥1000）" Style="{StaticResource LxCaption}" />
                <TextBox x:Name="TimeoutBox" Width="110" Margin="0,5,0,0" Padding="10,8" FontSize="13"
                         Background="{DynamicResource LxGlassFillBrush}"
                         Foreground="{DynamicResource LxTextPrimaryBrush}"
                         BorderBrush="{DynamicResource LxGlassBorderBrush}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="启用该目标" FontSize="13" Foreground="{DynamicResource LxTextPrimaryBrush}" />
                <TextBlock Text="停用后不上报（配置保留，可随时再启用）" Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox x:Name="EnabledSwitch" Grid.Column="1" Style="{StaticResource LxToggleSwitch}"
                      IsChecked="True" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="ErrorText" Style="{StaticResource LxCaption}" Margin="0,12,0,0"
                   Foreground="{DynamicResource LxStatusBadFgBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource LxPillButton}" IsCancel="True" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource LxAccentPillButton}" IsDefault="True"
                    Margin="10,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
