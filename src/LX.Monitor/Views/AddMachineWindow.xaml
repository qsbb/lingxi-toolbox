<Window x:Class="LingXi.Monitor.Views.AddMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LingXi.Ui.Controls;assembly=LX.Ui"
        Title="添加机器" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <!--
      添加机器悬浮窗（机器状态标题行 "+ 添加机器"）：自绘玻璃 Sheet。
      段 1 局域网 agent 接入（Hub 地址 / Token / 部署命令 + 复制）；段 2 上报目标摘要 + 二级入口。
      DataContext = DashboardViewModel（复制命令与入口命令直接绑定）。
      嵌套滚动铁律：全窗仅这一个 ScrollViewer。
    -->

    <!-- 玻璃 Sheet：阴影 Effect 按冻结陷阱内联在 Setter.Value，不做共享资源引用 -->
    <Border x:Name="Sheet" Margin="18"
            CornerRadius="{DynamicResource LxRadiusSheet}"
            Background="{DynamicResource LxPageBgBrush}"
            BorderBrush="{DynamicResource LxGlassBorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#53637D" />
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>

        <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16">

                <!-- 标题行 + 关闭（Path 自绘，避开 Segoe 字形豆腐块） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="添加机器" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="把官方 agent 指向本机 Hub，装好后自动出现在机器状态列表"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource LxIconGhostButton}" Click="Close_Click" ToolTip="关闭"
                            VerticalAlignment="Center">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="None"
                              Stroke="{DynamicResource LxTextSecondaryBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <!-- 段 1：局域网 agent 接入 -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusCard}" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="局域网 agent 接入" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="远程机器（含本机）的 agent 都用这个地址上报"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />

                        <!-- Hub LAN URL（大字等宽） -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hub 地址（局域网，取第一个非回环 IPv4）" Style="{StaticResource LxCaption}" />
                                <TextBlock Text="{Binding LanReportUrl}" FontSize="16" Margin="0,3,0,0"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding LanReportUrl}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock Text="本机回环地址（仅本机 agent 用）" Style="{StaticResource LxCaption}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding HubReportUrl}" Style="{StaticResource LxCaption}"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Hub Token -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hub Token" Style="{StaticResource LxCaption}" />
                                <TextBlock Text="{Binding HubToken}" FontSize="13" Margin="0,3,0,0"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding HubToken}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <!-- 官方 agent 部署命令模板 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Agent 部署命令（PowerShell，把 &lt;机器名&gt; 换成目标机器名）"
                                           Style="{StaticResource LxCaption}" />
                                <TextBlock Text="{Binding DeployCommand}" FontSize="12" Margin="0,3,0,0"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="{DynamicResource LxTextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" Style="{StaticResource LxPillButton}"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding DeployCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock Text="官方 agent v0.1.14 从 github.com/qsbb/servermonitor 获取（Node 18+ 或 pkg exe）；装好并开始上报后自动出现在机器状态列表。"
                                   Style="{StaticResource LxCaption}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:LxGlassCard>

                <!-- 段 2：上报到其他服务器（摘要 + 二级管理入口） -->
                <controls:LxGlassCard CornerRadius="{DynamicResource LxRadiusCard}" Padding="16,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="上报到其他服务器" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LxTextPrimaryBrush}" />
                        <TextBlock Text="本机指标按 servermonitor 协议上报给以下服务器（双向监控）"
                                   Style="{StaticResource LxCaption}" Margin="0,2,0,0" />

                        <TextBlock Text="还没有上报目标。点「管理上报目标…」把本机指标上报给任意 servermonitor 服务器。"
                                   Margin="0,10,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LxCaption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReporterTargets}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 当前上报目标摘要：URL + 最近上报状态 -->
                        <ItemsControl ItemsSource="{Binding ReporterTargets}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Url}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LxTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource LxCaption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:LxStatusPill Grid.Column="1" VerticalAlignment="Center"
                                                               Text="{Binding Status.StatusText}" Level="{Binding Status.Level}">
                                            <controls:LxStatusPill.Style>
                                                <Style TargetType="controls:LxStatusPill">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LxStatusPill.Style>
                                        </controls:LxStatusPill>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="管理上报目标…" Style="{StaticResource LxAccentPillButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding OpenReporterManagerCommand}"
                                ToolTip="添加 / 编辑 / 启停 / 删除上报目标" />
                    </StackPanel>
                </controls:LxGlassCard>

                <TextBlock Text="两段都即时生效：agent 装好后回到机器状态列表查看；上报目标改动按新配置自动重启上报端（无需重启工具箱）。"
                           Style="{StaticResource LxCaption}" Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
